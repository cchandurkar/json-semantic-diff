{
  "name": "json-semantic-diff",
  "version": "0.2.0",
  "description": "Framework-free JSON semantic diff engine with deterministic, explainable array identity matching.",
  "keywords": [
    "json",
    "diff",
    "semantic-diff",
    "json-diff",
    "array-matching",
    "identity-matching"
  ],
  "license": "MIT",
  "author": "Chaitanya Chandurkar",
  "homepage": "https://jsonsemanticdiff.dev",
  "bugs": "https://github.com/cchandurkar/json-semantic-diff/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/cchandurkar/json-semantic-diff.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.ts",
    "!src/**/*.fixture.ts"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11"
  }
}
